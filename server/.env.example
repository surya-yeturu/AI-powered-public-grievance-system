PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/smart-city-grievance
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000

# Auth (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Gemini (put your key here; never commit .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional tuning
# AGING_POINTS_PER_DAY=10
# AGING_MAX_DAYS=30
# ESCALATION_CRON=0 * * * *
